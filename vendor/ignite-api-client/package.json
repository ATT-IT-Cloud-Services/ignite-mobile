{
  "name": "@ignite/api-client",
  "version": "2.0.0",
  "description": "Official ignite API client",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ignite",
    "api",
    "client",
    "typescript",
    "hosting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ATT-IT-Cloud-Services/api-client-typescript.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
