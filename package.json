{
  "name": "elizon-mobile",
  "version": "1.0.4",
  "description": "elizon mobile client",
  "author": "elizon",
  "repository": {
    "type": "git",
    "url": "https://github.com/ATT-IT-Cloud-Services/ignite-mobile.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/sync-ignite-api-client.mjs",
    "postinstall": "node scripts/sync-ignite-api-client.mjs",
    "prebuild": "node scripts/sync-ignite-api-client.mjs",
    "dev": "node scripts/sync-ignite-api-client.mjs && bun --hot src/index.ts",
    "start": "node scripts/sync-ignite-api-client.mjs && NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "ios:sync": "bunx cap sync ios",
    "ios:build": "bun run build && bunx cap sync ios",
    "icons:desktop": "bun scripts/prepare-app-icons.mjs",
    "desktop:dev": "bun run build && electron .",
    "desktop:run": "bun run build && electron .",
    "desktop:build": "bun run build && bun run icons:desktop && electron-builder --publish never",
    "desktop:build:win": "bun run build && bun run icons:desktop && electron-builder --win --publish never",
    "desktop:build:win:builder": "bun run build && bun run icons:desktop && electron-builder --win --publish never",
    "desktop:build:win:portable": "bun run build && bun run icons:desktop && electron-builder --win portable --publish never",
    "desktop:build:win:msix": "bun run build && bun run icons:desktop && electron-builder --win msix --publish never",
    "desktop:build:mac": "bun run build && bun run icons:desktop && electron-builder --mac --publish never",
    "desktop:build:linux": "bun run build && bun run icons:desktop && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ignite/api-client": "file:./vendor/ignite-api-client",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "bun-plugin-tailwind": "^0.1.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.47.0",
    "novnc-next": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "electron": "^43.7.5",
    "electron-builder": "27.0.0-alpha.6",
    "electron-builder-squirrel-windows": "27.0.0-alpha.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "app.elizon.ignite.mobile",
    "productName": "elizon",
    "artifactName": "ignite-desktop-${version}.${ext}",
    "forceCodeSigning": false,
    "toolsets": {
      "winCodeSign": "1.3.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "msix",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "sign": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/electron-updater/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/semver/**",
      "node_modules/sax/**",
      "node_modules/lazy-val/**",
      "node_modules/tiny-typed-emitter/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ATT-IT-Cloud-Services",
        "repo": "ignite-mobile",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "ignite-desktop-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ignite-desktop-portable-${version}.${ext}"
    },
    "msix": {
      "identityName": "ZEMAGG.elizon",
      "publisher": "CN=873B2C9D-4A16-4295-8AC1-79853C7D1957",
      "publisherDisplayName": "ZEMAGG",
      "displayName": "elizon",
      "languages": ["de-DE", "en-US"],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "privateNetworkClientServer"
      ],
      "addAutoLaunchExtension": true,
      "createMsixupload": true,
      "artifactName": "ignite-desktop-${version}.${ext}"
    }
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "@xmldom/xmldom": "0.8.15",
    "@tootallnate/once": "2.0.1",
    "ip-address": "10.2.0",
    "tar": "7.5.22",
    "brace-expansion": "5.0.9",
    "shell-quote": "1.10.0",
    "fast-uri": "3.1.6",
    "uuid": "^11.1.1",
    "undici": "^7.29.0"
  }
}
